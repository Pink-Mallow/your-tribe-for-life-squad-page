<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Squad Page 2627</title>
    <link rel="stylesheet" href="/styling/global.css">
    <link rel="stylesheet" href="/styling/font.css">
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <span>2026-2027</span>
      <a href="/">Overview</a>
    </nav>
    <main>
      <h1 class="intro-text">FDND</h1>

      <h1>h1 text</h1>
      <h2>h2 text</h2>
      <h3>h3 text</h3>
      <h4>h4 text</h4>
      <h5>h5 text</h5>
      <h6>h6 text</h6>
      <p class="body-text">body text</p>
      <label for="">label text</label>
      <p class="small-text">small text</p>
      <button>button text</button>

      <h2>Overview</h2>
      <article>
        {% for person in persons %}
          <div class="card"> {%comment%} write article with class of card {%endcomment%}
            <img class="season-flower"> {%comment%} put seasonal flower in a component {%endcomment%}
            <a href="/">
              {{ person.name }}
            </a>
          </div>
        {% endfor %}
      </article>
      
      <section>
        {%  for person in persons %}
          <h3>{{ person.name }}</h3>
          <h4>Bio</h4>
          <p>{{ person.bio }}</p>
          <h4>Favorite animal:</h4>
          <p>{{ person.fav_animal }}</p>
          <h4>Favorite season:</h4>
          <p>
            {% if person.fav_season == "Winter" %}
              ❄️
            {% elsif person.fav_season == "Lente" %}
              🌷
            {% elsif person.fav_season == "Zomer" %}
              ☀️
            {% elsif person.fav_season == "Herfst" %}
              🍁
            {% else %}
              🌍
            {% endif %}
          </p>
          <a href="{{ person.profilecard }}">link to Profile Card</a>
        {% endfor %} 
      </section>
    </main>
  </body>
</html>