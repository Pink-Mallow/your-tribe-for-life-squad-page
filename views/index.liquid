<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Squad Page 2627</title>
    <link rel="stylesheet" href="/styling/global.css">
    <link rel="stylesheet" href="/styling/colour.css">
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <span>2026-2027</span>
      <a href="/">Overview</a>
    </nav>
    <main>
      <h1>FDND</h1>

      <ol>
        <li class="pb-darkest"></li>
        <li class="pb-darker"></li>
        <li class="pb-dark"></li>
        <li class="pb"></li>
        <li class="pb-light"></li>
        <li class="pb-lighter"></li>
        <li class="pb-lightest"></li>
      </ol>
    <ol>
        <li class="l-darkest"></li>
        <li class="l-darker"></li>
        <li class="l-dark"></li>
        <li class="l"></li>
        <li class="l-light"></li>
        <li class="l-lighter"></li>
        <li class="l-lightest"></li>
    </ol>
    <ol>
        <li class="bo-darkest"></li>
        <li class="bo-darker"></li>
        <li class="bo-dark"></li>
        <li class="bo"></li>
        <li class="bo-light"></li>
        <li class="bo-lighter"></li>
        <li class="bo-lightest"></li>
    </ol>
    <ol>
      <li class="neutral-darkest"></li>
      <li class="neutral-dark"></li>
      <li class="neutral"></li>
      <li class="neutral-light"></li>
      <li class="neutral-lightest"></li>
    </ol>
    <ol>
      <li class="warm-creme"></li>
      <li class="border-colour"></li>
    </ol>

      <h2>Overview</h2>
      <article>
        {% for person in persons %}
          <div class="card"> {%comment%} write article with class of card {%endcomment%}
            <img class="season-flower"> {%comment%} put seasonal flower in a component {%endcomment%}
            <a href="/">
              {{ person.name }}
            </a>
          </div>
        {% endfor %}
      </article>
      
      <section>
        {%  for person in persons %}
          <h3>{{ person.name }}</h3>
          <h4>Bio</h4>
          <p>{{ person.bio }}</p>
          <h4>Favorite animal:</h4>
          <p>{{ person.fav_animal }}</p>
          <h4>Favorite season:</h4>
          <p>
            {% if person.fav_season == "Winter" %}
              ❄️
            {% elsif person.fav_season == "Lente" %}
              🌷
            {% elsif person.fav_season == "Zomer" %}
              ☀️
            {% elsif person.fav_season == "Herfst" %}
              🍁
            {% else %}
              🌍
            {% endif %}
          </p>
          <a href="{{ person.profilecard }}">link to Profile Card</a>
        {% endfor %} 
      </section>
    </main>
  </body>
</html>