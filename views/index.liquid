<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Squad Page 2627</title>
    <link rel="stylesheet" href="/styling/global.css">
  </head>
  <body>
    <nav>
      <a href="/" alt="Link to the home page.">Home</a>
      <span>2026-2027</span>
      <a href="/" alt="Linkt to the overview page where you can choose wether you want to see the teachers or the students.">Overview</a>
    </nav>
    <div class="dates">
      <span class="date date-left">26<br>27</span>
      <span class="date date-right">26<br>27</span>
    </div>  
    <main>
      <h1>FDND</h1>

      <h2>Overview</h2>
      <article>
        {% for person in persons %}
          <div class="card"> {%comment%} write article with class of card {%endcomment%}
            <img class="season-flower"> {%comment%} put seasonal flower in a component {%endcomment%}
            <a href="/">
              {{ person.name }}
            </a>
          </div>
        {% endfor %}
      </article>
      
      <section>
        {%  for person in persons %}
          <h3>{{ person.name }}</h3>
          <h4>Bio</h4>
          <p>{{ person.bio }}</p>
          <h4>Favorite animal:</h4>
          <p>{{ person.fav_animal }}</p>
          <h4>Favorite season:</h4>
          <p>
            {% if person.fav_season == "Winter" %}
              ❄️
            {% elsif person.fav_season == "Lente" %}
              🌷
            {% elsif person.fav_season == "Zomer" %}
              ☀️
            {% elsif person.fav_season == "Herfst" %}
              🍁
            {% else %}
              🌍
            {% endif %}
          </p>
          <a href="{{ person.profilecard }}">link to Profile Card</a>
        {% endfor %} 
      </section>
    </main>
  </body>
</html>